# ===========================================
# Ghost Blog - .gitignore (HARDENED)
# ===========================================

# ==================
# SECRETS - CRITICAL
# ==================
# NEVER commit these files!
.env
.env.*
*.env
secrets/
credentials/
*.pem
*.key
*.crt
*.p12
*.pfx

# SSH Keys - ABSOLUTE NO!
ssh_keys/
*.tar.gz
id_rsa*
id_ed25519*
id_dsa*
id_ecdsa*
*.ppk
known_hosts*
authorized_keys

# API Keys & Tokens
*_api_key*
*_token*
*.secret

# ==================
# LOCAL DEVELOPMENT
# ==================
# Ghost Local Installation
ghost-local/

# Node modules
node_modules/

# Python virtual environment
.venv/
venv/
env/
__pycache__/
*.pyc
*.pyo

# Ghost MCP
ghost-mcp/

# ==================
# SYSTEM FILES
# ==================
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

# ==================
# IDE & EDITOR
# ==================
.vscode/
.idea/
*.sublime-*
.project
.settings/

# ==================
# LOGS & TEMP
# ==================
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.tmp
*.temp
*.bak
*.backup

# ==================
# BUILD ARTIFACTS
# ==================
dist/
build/
*.egg-info/
